  {
    "name": "fetch-post-with-headers-and-json-body",
    "js": "fetch('/api/p', {method: 'POST', headers: {'X-Token': 't', 'Content-Type': 'application/json'}, body: JSON.stringify({a: 1, b: 2})});",
    "expected": [
      {
        "url": "/api/p",
        "source": "js/fetch",
