      "selector": "#act-2",
      "role": "button",
      "name": "Pause feed",
      "logical_id": "act-2"
    },
    {
      "id": "act-3",
      "selector": "#act-3",
      "role": "button",
      "name": "Resume feed",
      "logical_id": "act-3"
    },
    {
      "id": "act-4",
      "selector": "#act-4",
      "role": "button",
      "name": "Open report",
      "logical_id": "act-4"
    },
    {
      "id": "act-5",
      "selector": "#act-5",
      "role": "button",
      "name": "Export",
      "logical_id": "act-5"
    },
    {
      "id": "act-6",
      "selector": "#act-6",
      "role": "button",
      "name": "Settings",
      "logical_id": "act-6"
    },
