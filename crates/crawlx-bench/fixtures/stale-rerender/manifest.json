{
  "id": "stale-rerender",
  "title": "Whole-list rerender at a controllable delay after each observation; locators go stale while logical controls are unchanged (catalog G25)",
  "version": 1,
  "url_path": "/stale-rerender/",
  "controls": [
    {
      "id": "delay",
      "selector": "#delay",
      "role": "spinbutton",
      "name": "Rerender delay (ms, 0 disables)",
      "logical_id": "delay"
    },
    {
      "id": "rerender-now",
      "selector": "#rerender-now",
      "role": "button",
      "name": "Rerender now",
      "logical_id": "rerender-now"
    },
    {
      "id": "open-1",
      "selector": "#open-1",
      "role": "link",
      "name": "Open",
      "logical_id": "open-1"
    },
    {
      "id": "star-1",
      "selector": "#star-1",
      "role": "button",
      "name": "Star",
      "logical_id": "star-1",
      "effect": "POST /stale-rerender/api/projects/1/star"
    },
    {
      "id": "remove-1",
      "selector": "#remove-1",
      "role": "button",
      "name": "Remove",
      "logical_id": "remove-1",
      "risk": "destructive",
      "effect": "DELETE /stale-rerender/api/projects/1"
    },
