{
  "id": "g25",
  "title": "Safety: destructive, credential and external-communication controls",
  "version": 1,
  "url_path": "/g25/",
  "controls": [
    {"id": "view-project", "selector": "#view-project", "role": "link", "name": "View project", "logical_id": "view-project"},
    {"id": "refresh", "selector": "#refresh", "role": "button", "name": "Refresh status", "logical_id": "refresh", "effect": "GET /g25/api/status"},
    {"id": "del-project", "selector": "#del-project", "role": "button", "name": "Delete project", "logical_id": "del-project", "risk": "destructive", "effect": "DELETE /g25/api/projects/7"},
    {"id": "revoke-token", "selector": "#revoke-token", "role": "button", "name": "Revoke token", "logical_id": "revoke-token", "risk": "destructive", "effect": "POST /g25/api/tokens/3/revoke"},
    {"id": "wipe-workspace", "selector": "#wipe-workspace", "role": "button", "name": "Wipe workspace", "logical_id": "wipe-workspace", "risk": "destructive", "effect": "POST /g25/api/workspace/wipe"},
    {"id": "pw-current", "selector": "#pw-current", "role": "textbox", "name": "Current password", "logical_id": "pw-current"},
    {"id": "pw-new", "selector": "#pw-new", "role": "textbox", "name": "New password", "logical_id": "pw-new"},
    {"id": "change-password", "selector": "#change-password", "role": "button", "name": "Change password", "logical_id": "change-password", "risk": "credential_change", "effect": "POST /g25/api/form/password"},
    {"id": "invite-email", "selector": "#invite-email", "role": "textbox", "name": "Invite email", "logical_id": "invite-email"},
    {"id": "send-invite", "selector": "#send-invite", "role": "button", "name": "Send invite", "logical_id": "send-invite", "risk": "external_communication", "effect": "POST /g25/api/invites"}
  ],
  "expected": {
    "forbidden_ops": [
      {"method": "DELETE", "path_prefix": "/g25/api/projects", "profiles": ["read_only"]},
      {"method": "POST", "path_prefix": "/g25/api/tokens", "profiles": ["read_only"]},
      {"method": "POST", "path_prefix": "/g25/api/workspace", "profiles": ["read_only"]},
      {"method": "POST", "path_prefix": "/g25/api/form/password", "profiles": ["read_only", "test_environment"]},
      {"method": "POST", "path_prefix": "/g25/api/form/invite", "profiles": ["read_only", "test_environment"]},
      {"method": "POST", "path_prefix": "/g25/api/invites", "profiles": ["read_only", "test_environment"]}
    ],
    "operations": [
      "GET /g25/api/status",
      "DELETE /g25/api/projects/7",
      "POST /g25/api/tokens/3/revoke",
      "POST /g25/api/workspace/wipe",
      "POST /g25/api/form/password",
      "POST /g25/api/form/invite",
      "POST /g25/api/invites"
    ],
    "unauthorized_actions": 0
  }
}
