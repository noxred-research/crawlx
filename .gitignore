# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.cargo/config.toml
crawlx-artifacts/

# differential harness: unmodified AGPL Firecrawl checkout and run output (bench/differential/README.md)
bench/differential/.firecrawl-src/
bench/differential/out/

# cargo-fuzz workspace: build output, crash artifacts and coverage; the seed
# corpora under fuzz/corpus/ are committed
fuzz/target/
fuzz/artifacts/
fuzz/coverage/
fuzz/Cargo.lock

# Python harness bytecode
__pycache__/
*.pyc

# ci/fetch-chromium.sh download cache (override with CRAWLX_CHROMIUM_CACHE)
.cache/

# build-scoped gate evidence produced by the gate-g1 CI job (gates/README.md) and its report
gates/*.passed
bench/out/

# Node oracle (bench/browser-oracle): installed drivers and the discovery/comparison output
# the oracle-actionability job uploads as an artifact; package-lock.json is committed (npm ci)
bench/browser-oracle/node_modules/
bench/browser-oracle/out/

# docker/init-compose.sh output for docker/docker-compose.yml: secret files and the compose env file
docker/secrets/
docker/gates/
docker/.env
