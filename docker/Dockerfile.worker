# crawlx-worker image: the `crawlx` binary plus the **pinned**
# Chromium build from chromium-pin.toml, fonts and tini on Debian slim, non-root, apt removed
# from the runtime layer. The Chrome for Testing archive is downloaded from the pin's
# `download_url` and verified against the pin's `sha256` at build time; a mismatch fails the
# build. Chromium's own sandbox stays on: `--no-sandbox` is never passed (the only code path
# that adds it is the env var CRAWLX_UNSAFE_NO_SANDBOX_FOR_CI, which this image does not set)
# and the pod runs under docker/seccomp/crawlx-chromium.json, which allows user-namespace
# creation for the sandbox and nothing wider.
#
#   docker build -f docker/Dockerfile.worker -t crawlx-worker:dev .
#
# Image tag convention: vX.Y.Z-chromium<four-part-version>.
ARG RUST_VERSION=1.97.1
ARG BASE_IMAGE=debian:bookworm-slim

FROM rust:${RUST_VERSION}-slim-bookworm AS builder
# Empty by default. `onnx` enables operator-installed language bundles; no runtime is downloaded.
ARG CRAWLX_CARGO_FEATURES=""
# BoringSSL's opt-in ClientHello transport builds bundled native sources and bindings.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake clang libclang-dev git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml clippy.toml rustfmt.toml ./
COPY crates ./crates
COPY vendor ./vendor
COPY chromium-pin.toml cdp-surface.toml ./
# crawlx-bench (a dependency of crawlx-cli) compiles bench/seeds.toml in with `include_str!`
COPY bench/seeds.toml ./bench/seeds.toml
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release -p crawlx-cli --bin crawlx --features "${CRAWLX_CARGO_FEATURES}" \
    && install -D -m 0755 target/release/crawlx /out/usr/local/bin/crawlx

# Chromium is fetched in its own stage so a pin bump re-runs only this layer.
FROM ${BASE_IMAGE} AS chromium
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /pin
COPY chromium-pin.toml .
# Parse the two pin fields with the tools in the base image; the archive must match the
# SHA-256 recorded next to the version (a browser bump is a release, not a refresh).
RUN set -eu; \
    url="$(sed -n 's/^download_url *= *"\([^"]*\)".*/\1/p' chromium-pin.toml)"; \
    sha="$(sed -n 's/^sha256 *= *"\([^"]*\)".*/\1/p' chromium-pin.toml)"; \
    version="$(sed -n 's/^version *= *"\([^"]*\)".*/\1/p' chromium-pin.toml)"; \
    test -n "$url" -a -n "$sha" -a -n "$version"; \
    echo "fetching Chromium $version"; \
    curl -fsSLo chrome-linux64.zip "$url"; \
    echo "$sha  chrome-linux64.zip" | sha256sum -c -; \
    unzip -q chrome-linux64.zip -d /opt; \
    mv /opt/chrome-linux64 /opt/chromium; \
    rm chrome-linux64.zip; \
    printf '%s\n' "$version" > /opt/chromium/PINNED_VERSION

FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.title="crawlx-worker" \
      org.opencontainers.image.description="crawlx lease-loop worker with the pinned Chromium build" \
      org.opencontainers.image.source="https://github.com/noxred-research/crawlx"
# Runtime libraries Chrome for Testing links against, fonts, tini. The package manager is
# removed afterwards: the runtime layer must not be able to install anything.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates tini \
        libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 libdbus-1-3 \
        libdrm2 libexpat1 libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0 libx11-6 \
        libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
        fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt /etc/apt /usr/lib/apt /usr/bin/apt /usr/bin/apt-get \
           /usr/bin/apt-cache /usr/bin/apt-config /usr/bin/apt-key /usr/bin/apt-mark /usr/bin/dpkg* \
    && groupadd --system --gid 10001 crawlx \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin crawlx \
    && mkdir -p /tmp/crawlx /var/lib/crawlx \
    && chown crawlx:crawlx /tmp/crawlx /var/lib/crawlx
COPY --from=chromium /opt/chromium /opt/chromium
COPY --from=builder /out/usr/local/bin/crawlx /usr/local/bin/crawlx
COPY chromium-pin.toml /etc/crawlx/chromium-pin.toml
USER 10001:10001
# `CRAWLX_CHROMIUM_PATH` is what crawlx-browser launches. The pin check compares Browser.getVersion
# with the pin at every launch and finds it by searching the working directory and its ancestors
# (or `CRAWLX_PIN_FILE`, which `crawlx config check` does not list as a known variable), so the
# working directory is the one that holds /etc/crawlx/chromium-pin.toml; from `/` it is not found.
WORKDIR /etc/crawlx
ENV CRAWLX_CHROMIUM_PATH=/opt/chromium/chrome \
    CRAWLX_ENVIRONMENT=prod \
    TMPDIR=/tmp/crawlx \
    HOME=/tmp/crawlx
EXPOSE 9464
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/crawlx"]
CMD ["worker"]
