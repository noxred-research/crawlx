+
+#include "chrome/browser/signin/account_investigator_factory.h"
+
+#include "base/command_line.h"
+#include "base/test/metrics/histogram_tester.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/signin/identity_manager_factory.h"
+#include "chrome/browser/signin/signin_browser_test_base.h"
+#include "chrome/common/chrome_switches.h"
+#include "components/prefs/pref_service.h"
+#include "components/signin/public/base/signin_pref_names.h"
+#include "components/signin/public/identity_manager/accounts_in_cookie_jar_info.h"
+#include "components/signin/public/identity_manager/identity_manager.h"
+#include "content/public/test/browser_test.h"
+#include "google_apis/gaia/gaia_id.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+class AccountInvestigatorFactoryBrowserTest
+    : public SigninBrowserTestBase,
+      public testing::WithParamInterface<bool> {
+ protected:
+  void SetUpDefaultCommandLine(base::CommandLine* command_line) override {
+    SigninBrowserTestBase::SetUpDefaultCommandLine(command_line);
+    // Browser tests normally disable background networking. Exercise both paths
+    // after the default switches have been installed, before profile creation.
+    command_line->RemoveSwitch(switches::kDisableBackgroundNetworking);
+    if (GetParam()) {
+      command_line->AppendSwitch(switches::kDisableBackgroundNetworking);
+    }
+  }
+};
+
+IN_PROC_BROWSER_TEST_P(AccountInvestigatorFactoryBrowserTest,
+                       BackgroundNetworkingControlsMetricsOnly) {
+  ASSERT_EQ(base::CommandLine::ForCurrentProcess()->HasSwitch(
+                switches::kDisableBackgroundNetworking),
+            GetParam());
+
+  // A fresh profile's overdue timer fires synchronously during Initialize().
+  // Check before GetForProfile() so a lazy lookup cannot mask lost eager startup.
+  EXPECT_EQ(GetProfile()
+                ->GetPrefs()
+                ->GetTime(prefs::kGaiaCookiePeriodicReportTime)
+                .is_null(),
+            GetParam());
+  EXPECT_EQ(AccountInvestigatorFactory::GetForProfile(GetProfile()) == nullptr,
+            GetParam());
+
+  ASSERT_EQ(IdentityManagerFactory::GetForProfile(GetProfile()),
+            identity_manager());
+  const base::HistogramTester histogram_tester;
+  // This uses the real cookie service with a test ListAccounts response, not a
+  // replacement AccountInvestigator factory. Cookie consumers must still work.
+  identity_test_env()->SetCookieAccounts(
+      {{"user@example.com", GaiaId("123")}});
+  const auto accounts = identity_manager()->GetAccountsInCookieJar();
+  ASSERT_TRUE(accounts.AreAccountsFresh());
+  const auto& signed_in_accounts =
+      accounts.GetPotentiallyInvalidSignedInAccounts();
+  ASSERT_EQ(signed_in_accounts.size(), 1u);
+  EXPECT_EQ(signed_in_accounts.front().email, "user@example.com");
+
+  if (GetParam()) {
+    EXPECT_TRUE(histogram_tester.GetTotalCountsForPrefix("Signin.CookieJar.")
+                    .empty());
+  } else {
+    histogram_tester.ExpectUniqueSample("Signin.CookieJar.SignedInCount_OnChange",
+                                       1, 1);
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(All,
+                         AccountInvestigatorFactoryBrowserTest,
+                         testing::Bool());
+
+}  // namespace
