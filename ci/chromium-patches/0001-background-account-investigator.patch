@@ -40,6 +42,14 @@
 std::unique_ptr<KeyedService>
 AccountInvestigatorFactory::BuildServiceInstanceForBrowserContext(
     content::BrowserContext* context) const {
+  // This metrics-only service must not initiate background ListAccounts fetches
+  // when background networking is disabled. IdentityManager and its cookie
+  // services remain available to explicit consumers.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kDisableBackgroundNetworking)) {
+    return nullptr;
+  }
+
   Profile* profile(Profile::FromBrowserContext(context));
   std::unique_ptr<AccountInvestigator> investigator =
       std::make_unique<AccountInvestigator>(
