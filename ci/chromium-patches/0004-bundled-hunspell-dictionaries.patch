+class SpellcheckHunspellDictionaryTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(user_dir_.CreateUniqueTempDir());
+    ASSERT_TRUE(assets_dir_.CreateUniqueTempDir());
+    dictionary_override_ = std::make_unique<base::ScopedPathOverride>(
+        chrome::DIR_APP_DICTIONARIES, user_dir_.GetPath());
+    assets_override_ = std::make_unique<base::ScopedPathOverride>(
+        base::DIR_ASSETS, assets_dir_.GetPath());
+    ASSERT_TRUE(base::CreateDirectory(InstalledPath().DirName()));
+    base::FilePath source_root;
+    ASSERT_TRUE(base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT,
+                                       &source_root));
+    fixture_path_ = spellcheck::GetVersionedFileName(
+        "en-US", source_root.AppendASCII("third_party")
+                     .AppendASCII("hunspell_dictionaries"));
+    ASSERT_TRUE(base::PathExists(fixture_path_));
+  }
+
+  base::FilePath UserPath(const std::string& language = "en-US") const {
+    return spellcheck::GetVersionedFileName(language, user_dir_.GetPath());
+  }
+
+  base::FilePath InstalledPath() const {
+    return spellcheck::GetVersionedFileName(
+        "en-US", assets_dir_.GetPath().AppendASCII("Dictionaries"));
+  }
+
+  void InstallDictionary(const base::FilePath& destination) {
+    ASSERT_TRUE(base::CopyFile(fixture_path_, destination));
+  }
+
+  std::unique_ptr<SpellcheckHunspellDictionary> Open(
+      const std::string& language = "en-US") {
+    auto dictionary = std::make_unique<SpellcheckHunspellDictionary>(
+        language, std::string(), nullptr, nullptr);
+    dictionary->dictionary_file_ =
+        SpellcheckHunspellDictionary::InitializeDictionaryLocation(
+            dictionary->task_runner_.get(), language);
+    return dictionary;
+  }
+
+  base::FilePath OpenedPath(const SpellcheckHunspellDictionary& dictionary) {
+    return dictionary.dictionary_file_.path;
+  }
+
+  GURL DownloadURL(SpellcheckHunspellDictionary& dictionary) {
+    return dictionary.GetDictionaryURL();
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  base::ScopedAllowBlockingForTesting allow_blocking_;
+  base::ScopedTempDir user_dir_;
+  base::ScopedTempDir assets_dir_;
+  base::FilePath fixture_path_;
+  std::unique_ptr<base::ScopedPathOverride> dictionary_override_;
+  std::unique_ptr<base::ScopedPathOverride> assets_override_;
+};
+
+TEST_F(SpellcheckHunspellDictionaryTest, InstalledDictionaryForFreshProfile) {
+  InstallDictionary(InstalledPath());
+  auto dictionary = Open();
+  EXPECT_TRUE(dictionary->IsReady());
+  EXPECT_EQ(InstalledPath(), OpenedPath(*dictionary));
+  EXPECT_FALSE(base::PathExists(UserPath()));
+  EXPECT_TRUE(base::ContentsEqual(fixture_path_, InstalledPath()));
+}
+
+TEST_F(SpellcheckHunspellDictionaryTest, UserDictionaryTakesPrecedence) {
+  InstallDictionary(InstalledPath());
+  InstallDictionary(UserPath());
+  auto dictionary = Open();
+  EXPECT_TRUE(dictionary->IsReady());
+  EXPECT_EQ(UserPath(), OpenedPath(*dictionary));
+  EXPECT_TRUE(base::ContentsEqual(fixture_path_, InstalledPath()));
+}
+
+TEST_F(SpellcheckHunspellDictionaryTest, CorruptUserFallsBackToInstalled) {
+  InstallDictionary(InstalledPath());
+  ASSERT_TRUE(base::WriteFile(UserPath(), "BDic corrupt user dictionary"));
+  auto dictionary = Open();
+  EXPECT_TRUE(dictionary->IsReady());
+  EXPECT_EQ(InstalledPath(), OpenedPath(*dictionary));
+  EXPECT_FALSE(base::PathExists(UserPath()));
+  EXPECT_TRUE(base::ContentsEqual(fixture_path_, InstalledPath()));
+}
+
+TEST_F(SpellcheckHunspellDictionaryTest, CorruptInstalledPreservedAndNotReady) {
+  const std::string corrupt = "BDic corrupt installed dictionary";
+  ASSERT_TRUE(base::WriteFile(InstalledPath(), corrupt));
+  ASSERT_TRUE(base::WriteFile(UserPath(), "BDic corrupt user dictionary"));
+  auto dictionary = Open();
+  EXPECT_FALSE(dictionary->IsReady());
+  EXPECT_EQ(UserPath(), OpenedPath(*dictionary));
+  EXPECT_FALSE(base::PathExists(UserPath()));
+  std::string contents;
+  ASSERT_TRUE(base::ReadFileToString(InstalledPath(), &contents));
+  EXPECT_EQ(corrupt, contents);
+  EXPECT_EQ(
+      GURL("https://redirector.gvt1.com/edgedl/chrome/dict/en-us-10-2.bdic"),
+      DownloadURL(*dictionary));
+}
+
+TEST_F(SpellcheckHunspellDictionaryTest, MissingInstalledRetainsDownloadPath) {
+  auto dictionary = Open();
+  EXPECT_FALSE(dictionary->IsReady());
+  EXPECT_EQ(UserPath(), OpenedPath(*dictionary));
+  EXPECT_FALSE(base::PathExists(InstalledPath()));
+  EXPECT_EQ(
+      GURL("https://redirector.gvt1.com/edgedl/chrome/dict/en-us-10-2.bdic"),
+      DownloadURL(*dictionary));
+}
+
+TEST_F(SpellcheckHunspellDictionaryTest, OtherLanguagesRetainDownloadPath) {
+  InstallDictionary(InstalledPath());
+  auto dictionary = Open("fr");
+  EXPECT_FALSE(dictionary->IsReady());
+  EXPECT_EQ(UserPath("fr"), OpenedPath(*dictionary));
+  EXPECT_EQ(GURL("https://redirector.gvt1.com/edgedl/chrome/dict/" +
+                 base::ToLowerASCII(UserPath("fr").BaseName().MaybeAsASCII())),
+            DownloadURL(*dictionary));
+}
+#endif  // BUILDFLAG(IS_LINUX)
