+
+TEST_P(FmRegistrationTokenUploaderLifecycleTest,
+       ShutdownRemovesObserversBeforeLaterRegistration) {
+  auto client = std::make_unique<MockCloudPolicyClient>();
+  auto* client_ptr = client.get();
+  EXPECT_CALL(*client_ptr, UploadFmRegistrationToken(_, _)).Times(0);
+  core_.Connect(std::move(client));
+  auto uploader = CreateUploader();
+  const int expected = GetParam() ? 0 : 1;
+  ExpectRequests(expected);
