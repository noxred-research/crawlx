+TEST_F(FmRegistrationTokenUploaderTest, DeferredListenerHandlesCoreDestruction) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      switches::kDisableBackgroundNetworking);
+  auto core = std::make_unique<CloudPolicyCore>(
+      dm_protocol::kChromeMachineLevelUserCloudPolicyType, std::string(),
+      &mock_store_, task_environment_.GetMainThreadTaskRunner(),
+      network::TestNetworkConnectionTracker::CreateGetter());
+  core->Connect(std::make_unique<MockCloudPolicyClient>());
+  EXPECT_CALL(mock_invalidation_listener_, Start(_)).Times(0);
+  EXPECT_CALL(mock_invalidation_listener_, Shutdown()).Times(0);
+  auto uploader = std::make_unique<FmRegistrationTokenUploader>(
+      PolicyInvalidationScope::kUser, &mock_invalidation_listener_, core.get());
+  core.reset();
+  task_environment_.RunUntilIdle();
+  uploader.reset();
+}
