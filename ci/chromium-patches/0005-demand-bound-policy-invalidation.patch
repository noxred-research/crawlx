+class FmRegistrationTokenUploaderLifecycleTest
+    : public FmRegistrationTokenUploaderTest,
+      public testing::WithParamInterface<bool> {
+ protected:
+  void SetUp() override {
+    base::CommandLine* command_line = command_line_.GetProcessCommandLine();
+    command_line->RemoveSwitch(switches::kDisableBackgroundNetworking);
+    if (GetParam()) {
+      command_line->AppendSwitch(switches::kDisableBackgroundNetworking);
+    }
+  }
+
+  std::unique_ptr<FmRegistrationTokenUploader> CreateUploader() {
+    return std::make_unique<FmRegistrationTokenUploader>(
+        PolicyInvalidationScope::kUser, listener_.get(), &core_);
+  }
+
+  void ExpectRequests(int expected) {
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(gcm_driver_.instance_data_requests, expected);
+    EXPECT_EQ(gcm_driver_.token_requests, expected);
+    EXPECT_EQ(instance_id_driver_.ExistsInstanceID(app_id_), expected != 0);
+    EXPECT_EQ(gcm_driver_.GetAppHandler(app_id_) != nullptr, expected != 0);
+  }
+
+  base::test::ScopedCommandLine command_line_;
+  CountingGCMDriver gcm_driver_;
+  instance_id::InstanceIDDriver instance_id_driver_{&gcm_driver_};
+  std::unique_ptr<invalidation::InvalidationListener> listener_ =
+      invalidation::InvalidationListener::Create(
+          &gcm_driver_, &instance_id_driver_, kFakeProjectNumber, "[test]");
+  const std::string app_id_ =
+      std::string(invalidation::InvalidationListener::kFmAppId) + "-1234567890";
+};
