+// Exercise the real listener, InstanceIDDriver and InstanceIDImpl. Count both
+// store reads (the eager desktop startup path) and registration token fetches.
+class CountingGCMDriver : public instance_id::FakeGCMDriverForInstanceID {
+ public:
+  int instance_data_requests = 0;
+  int token_requests = 0;
+
+ protected:
+  void GetInstanceIDData(const std::string& app_id,
+                         GetInstanceIDDataCallback callback) override {
+    ++instance_data_requests;
+    FakeGCMDriverForInstanceID::GetInstanceIDData(app_id, std::move(callback));
+  }
+
+  void GetToken(const std::string& app_id,
+                const std::string& authorized_entity,
+                const std::string& scope,
+                base::TimeDelta time_to_live,
+                GetTokenCallback callback) override {
+    ++token_requests;
+    FakeGCMDriverForInstanceID::GetToken(
+        app_id, authorized_entity, scope, time_to_live, std::move(callback));
+  }
+};
+
+}  // namespace
