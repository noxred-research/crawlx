+TEST_P(FmRegistrationTokenUploaderLifecycleTest,
+       UnregisteredClientDoesNotFetchWithoutDemand) {
+  auto client = std::make_unique<MockCloudPolicyClient>();
+  EXPECT_CALL(*client, UploadFmRegistrationToken(_, _)).Times(0);
+  core_.Connect(std::move(client));
+
+  auto uploader = CreateUploader();
+  ExpectRequests(GetParam() ? 0 : 1);
+}
+
+TEST_P(FmRegistrationTokenUploaderLifecycleTest,
+       RegisteredClientStartsAndUploadsOnce) {
+  auto client = std::make_unique<MockCloudPolicyClient>();
+  auto* client_ptr = client.get();
+  client_ptr->SetDMToken(kFakeDMToken);
+  SetRegistrationTokenUploadState(
+      *client_ptr,
+      CloudPolicyClient::Result(DeviceManagementStatus::DM_STATUS_SUCCESS));
+  EXPECT_CALL(*client_ptr, UploadFmRegistrationToken(_, _)).Times(1);
+  core_.Connect(std::move(client));
+
+  auto uploader = CreateUploader();
+  ExpectRequests(1);
+  client_ptr->NotifyRegistrationStateChanged();
+  client_ptr->NotifyRegistrationStateChanged();
+  ExpectRequests(1);
+}
+
+TEST_P(FmRegistrationTokenUploaderLifecycleTest,
+       LateConnectionAndRegistrationStartOnce) {
+  auto uploader = CreateUploader();
+  ExpectRequests(GetParam() ? 0 : 1);
+
+  auto client = std::make_unique<MockCloudPolicyClient>();
+  auto* client_ptr = client.get();
+  core_.Connect(std::move(client));
