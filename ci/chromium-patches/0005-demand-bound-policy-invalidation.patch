   CHECK_NE(scope_, PolicyInvalidationScope::kDeviceLocalAccount)
       << "Registration token is not expected for device local "
          "accounts";
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kDisableBackgroundNetworking)) {
+    // Starting the listener fetches an InstanceID token, which can initiate GCM
+    // check-in even for a new, unmanaged profile. Wait for an actual policy
+    // registration instead; do not disable invalidations for managed clients.
+    startup_core_observation_.Observe(core_);
+    OnCoreConnected(core_);
+  } else {
+    StartInvalidationListener();
+  }
+}
+
+FmRegistrationTokenUploader::~FmRegistrationTokenUploader() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  startup_client_observation_.Reset();
+  startup_core_observation_.Reset();
+  if (listener_started_) {
+    invalidation_listener_->Shutdown();
+  }
+}
+
+void FmRegistrationTokenUploader::StartInvalidationListener() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(!listener_started_);
+  startup_client_observation_.Reset();
+  startup_core_observation_.Reset();
+  listener_started_ = true;
   invalidation_listener_->Start(this);
 }
 
-FmRegistrationTokenUploader::~FmRegistrationTokenUploader() {
-  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
-
-  invalidation_listener_->Shutdown();
+void FmRegistrationTokenUploader::OnCoreConnected(CloudPolicyCore* core) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (CloudPolicyClient* client = core->client()) {
+    startup_client_observation_.Observe(client);
+    OnRegistrationStateChanged(client);
+  }
+}
+
+void FmRegistrationTokenUploader::OnRefreshSchedulerStarted(
+    CloudPolicyCore* core) {}
+
+void FmRegistrationTokenUploader::OnCoreDisconnecting(CloudPolicyCore* core) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Disconnect destroys the client after notifying observers. Keep observing
+  // the core so a later managed connection can still start the listener.
+  startup_client_observation_.Reset();
+}
+
+void FmRegistrationTokenUploader::OnCoreDestruction(CloudPolicyCore* core) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  startup_client_observation_.Reset();
+  startup_core_observation_.Reset();
+  core_ = nullptr;
+}
+
+void FmRegistrationTokenUploader::OnRegistrationStateChanged(
+    CloudPolicyClient* client) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (client->is_registered()) {
+    StartInvalidationListener();
+  }
 }
 
