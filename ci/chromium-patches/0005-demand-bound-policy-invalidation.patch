+  uploader.reset();
+  client_ptr->SetDMToken(kFakeDMToken);
+  client_ptr->NotifyRegistrationStateChanged();
+  core_.Disconnect();
+  client = std::make_unique<MockCloudPolicyClient>();
+  client->SetDMToken(kFakeDMToken);
+  EXPECT_CALL(*client, UploadFmRegistrationToken(_, _)).Times(0);
+  core_.Connect(std::move(client));
+  task_environment_.FastForwardBy(base::Days(2));
+  EXPECT_EQ(gcm_driver_.instance_data_requests, expected);
+  EXPECT_EQ(gcm_driver_.token_requests, expected);
+  EXPECT_EQ(gcm_driver_.GetAppHandler(app_id_), nullptr);
+}
+
+TEST_P(FmRegistrationTokenUploaderLifecycleTest,
+       ShutdownCancelsPendingTokenDelivery) {
+  auto client = std::make_unique<MockCloudPolicyClient>();
+  client->SetDMToken(kFakeDMToken);
+  EXPECT_CALL(*client, UploadFmRegistrationToken(_, _)).Times(0);
+  core_.Connect(std::move(client));
