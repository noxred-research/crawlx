+TEST_F(ChromeAutofillClientTest, BackgroundNetworkingOnlyDisablesCrowdsourcing) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(
+      features::debug::kAutofillServerCommunication);
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      ::switches::kDisableBackgroundNetworking);
+  EXPECT_TRUE(client()->IsAutofillCrowdsourcingAllowed());
+  EXPECT_TRUE(client()->GetCrowdsourcingManager().IsEnabled());
+
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      ::switches::kDisableBackgroundNetworking);
+  EXPECT_FALSE(client()->IsAutofillCrowdsourcingAllowed());
+  EXPECT_FALSE(client()->GetCrowdsourcingManager().IsEnabled());
+  EXPECT_TRUE(client()->IsAutofillEnabled());
+  EXPECT_TRUE(client()->IsAutofillProfileEnabled());
+  EXPECT_TRUE(client()->IsAutocompleteEnabled());
+
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      ::switches::kDisableBackgroundNetworking);
+  EXPECT_TRUE(client()->GetCrowdsourcingManager().IsEnabled());
+}
