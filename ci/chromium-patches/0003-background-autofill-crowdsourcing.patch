+TEST_F(AutofillCrowdsourcingManagerTest, ClientCanDisableCrowdsourcing) {
+  class PolicyAutofillClient : public TestAutofillClient {
+   public:
+    bool IsAutofillCrowdsourcingAllowed() const override { return allowed; }
+    bool allowed = false;
+  };
+
+  // Other embedders retain the default policy.
+  EXPECT_TRUE(autofill_client().IsAutofillCrowdsourcingAllowed());
+  PolicyAutofillClient client;
+  client.set_shared_url_loader_factory(autofill_client().GetURLLoaderFactory());
+  AutofillCrowdsourcingManager manager(&client, version_info::Channel::UNKNOWN);
+  FormData form = test::GetFormData(
+      {.fields = {{.role = NAME_FIRST},
+                  {.role = NAME_LAST},
+                  {.role = EMAIL_ADDRESS}}});
+  FormStructure form_structure(form);
+  form_structure.set_submission_source(SubmissionSource::FORM_SUBMISSION);
+  SetCorrectFieldHostFormSignatures(form_structure);
+  EncodeUploadRequestOptions options;
+  options.encoder = RandomizedEncoder::Create(client.GetPrefs());
+  options.observed_submission = true;
+  std::vector<AutofillUploadContents> uploads =
+      EncodeUploadRequest(form_structure, options);
+  ASSERT_FALSE(uploads.empty());
+
+  EXPECT_FALSE(manager.IsEnabled());
+  int callback_count = 0;
+  EXPECT_FALSE(manager.StartQueryRequest(
+      {form}, autofill_driver().GetIsolationInfo(),
+      base::BindLambdaForTesting(
+          [&](std::optional<AutofillCrowdsourcingManager::QueryResponse> response) {
+            ++callback_count;
+            EXPECT_FALSE(response.has_value());
+          })));
+  EXPECT_EQ(callback_count, 1);
+  for (bool password_manager_upload : {false, true}) {
+    EXPECT_FALSE(manager.StartUploadRequest(
+        uploads, form_structure.submission_source(), password_manager_upload));
+  }
+  task_environment().RunUntilIdle();
+  EXPECT_EQ(callback_count, 1);
+  EXPECT_EQ(url_loader_factory().NumPending(), 0);
+  EXPECT_TRUE(client.IsAutofillEnabled());
+  EXPECT_TRUE(client.IsAutofillProfileEnabled());
+  EXPECT_TRUE(client.IsAutocompleteEnabled());
+
+  // The same valid form and vote must reach the loader when policy allows it.
+  // Refused uploads must not consume the upload-throttling budget.
+  client.allowed = true;
+  EXPECT_TRUE(manager.IsEnabled());
+  EXPECT_TRUE(manager.StartQueryRequest(
+      {form}, autofill_driver().GetIsolationInfo(),
+      base::BindOnce(
+          [](std::optional<AutofillCrowdsourcingManager::QueryResponse>) {})));
+  EXPECT_TRUE(manager.StartUploadRequest(
+      std::move(uploads), form_structure.submission_source(),
+      /*is_password_manager_upload=*/false));
+  task_environment().RunUntilIdle();
+  EXPECT_EQ(url_loader_factory().NumPending(), 2);
+}
