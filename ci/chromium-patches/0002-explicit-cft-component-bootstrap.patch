+class ComponentUpdaterTimerSchedulerTest : public testing::TestWithParam<bool> {
+ protected:
+  base::test::TaskEnvironment environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+};
+
+TEST_P(ComponentUpdaterTimerSchedulerTest, AutomaticUpdates) {
+  TimerUpdateScheduler scheduler(/*enabled=*/GetParam());
+  int count = 0;
+  scheduler.Schedule(
+      base::Seconds(1), base::Seconds(2),
+      base::BindRepeating(
+          [](int* count, UpdateScheduler::OnFinishedCallback on_finished) {
+            ++*count;
+            std::move(on_finished).Run();
+          },
+          &count),
+      base::DoNothing());
+
+  environment_.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(GetParam() ? 3 : 0, count);
+
+  scheduler.Stop();
+  environment_.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(GetParam() ? 3 : 0, count);
+}
+
+INSTANTIATE_TEST_SUITE_P(All,
+                         ComponentUpdaterTimerSchedulerTest,
