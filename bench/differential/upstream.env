# Compose environment for the unmodified upstream self-host (pinned commit
# c31e88c07afe941bfd8aebde61684eeba042abb5) started by docker-compose.upstream.yaml.
#
# Passed to `docker compose --env-file`, i.e. the role of the root `.env` of the upstream
# checkout. At the pin that file only overrides variables the root `docker-compose.yaml`
# references (the upstream self-host guide says its API example env file is not a drop-in Compose
# contract), so this file names only such variables. Verified against the pin on the first
# networked run (2026-10-28): every key below is read by `docker-compose.yaml`; the keys the
# previous revision of this file carried (HOST, REDIS_*, NUQ_DATABASE_URL, NUQ_RABBITMQ_URL,
# PLAYWRIGHT_MICROSERVICE_URL, wire-compat: upstream variable name) are either hard-coded in the upstream Compose or equal its
# defaults and were dropped.
#
# No database authentication (no hosted auth backend), no LLM or search provider keys, no proxy.
USE_DB_AUTHENTICATION=false
# Host port the API is published on; run.sh overrides it from UPSTREAM_PORT (shell wins).
PORT=3002
INTERNAL_PORT=3002
# Read by the headless-browser service: it refuses targets that resolve to private addresses unless
# this is true, and the gym runs on the host. The API container gets the same switch from
# docker-compose.upstream.yaml (its safeFetch reads the same key).
ALLOW_LOCAL_WEBHOOKS=true
# Workers and concurrency stay at the upstream defaults; the crawl request itself sets
# maxConcurrency.
LOGGING_LEVEL=INFO
